TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
FRED_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
# Local PostgreSQL over Unix socket (systemd installation)
DATABASE_URL=postgresql+psycopg:///doublem?host=/var/run/postgresql
LOG_LEVEL=INFO
WATCHLIST=SPY,QQQ,IWM
QUOTE_REFRESH_MINUTES=30
DAILY_REFRESH_HOUR_UTC=22
PROVIDER_DAILY_BUDGET=700
HTTP_TIMEOUT_SECONDS=15
